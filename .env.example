OPENAI_API_KEY=sk-your-key-here
# Defaults used when a request doesn't send model/quality
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY=high
# Rupees per 1 US dollar, used for cost tracking
USD_TO_INR=96.64
# Model that reads the image and the master prompt (gpt-6.1-sol, gpt-6-astra or gpt-6-luna)
OPENAI_TEXT_MODEL=gpt-6.1-sol
# Web app password (leave empty for no password). Strongly recommended on a public server.
APP_PASSWORD=
# Google AI Studio key, only needed for Nano Banana (get one at https://aistudio.google.com/apikey; billing must be on)
GEMINI_API_KEY=
# Optional: Nano Banana thinking level (minimal, medium or high). Leave empty for the model's default.
NANO_THINKING=
# Meta Model API key, only needed for Muse Image (create one at https://dev.meta.ai/ -> API keys)
MODEL_API_KEY=
